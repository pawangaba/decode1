---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  calculators,
  getCalculatorBySlug
} from "../../engine/calculator-registry";

export function getStaticPaths() {
  return calculators.map((calculator) => ({
    params: {
      slug: calculator.slug
    },
    props: {
      calculator
    }
  }));
}

const calculator: any =
  Astro.props.calculator ??
  getCalculatorBySlug(Astro.params.slug ?? "");

if (!calculator) {
  throw new Error(
    `Calculator not found: ${Astro.params.slug}`
  );
}

/*
 * Some calculator definitions may contain a single reference
 * instead of an array. Normalize them so the page never crashes.
 */
const references = Array.isArray(calculator.references)
  ? calculator.references
  : calculator.references
    ? [calculator.references]
    : [];

const inputs = Array.isArray(calculator.inputs)
  ? calculator.inputs
  : [];
---

<BaseLayout
  title={`${calculator.title} | LABDECODED`}
  description={
    calculator.description ??
    `Medical calculator for ${calculator.title}`
  }
>

  <main class="calculator-page">

    <!-- Breadcrumb -->
    <div class="breadcrumb">

      <a href="/calculators/">
        Medical Calculators
      </a>

      <span>/</span>

      <span>
        {calculator.category ?? "Clinical"}
      </span>

    </div>


    <!-- Calculator Header -->
    <header class="calculator-header">

      <div class="category-badge">
        {calculator.category ?? "Clinical Calculator"}
      </div>

      <h1>
        {calculator.title}
      </h1>

      {
        calculator.description && (
          <p class="description">
            {calculator.description}
          </p>
        )
      }

    </header>


    <!-- Main Calculator Card -->
    <section class="calculator-card">

      <form
        id="calculator-form"
        data-calculator={calculator.slug}
      >

        <!-- Inputs -->
        <div class="input-grid">

          {
            inputs.map((input: any) => {

              const id =
                input.id ??
                input.name ??
                "input";

              const label =
                input.label ??
                input.name ??
                id;

              const type =
                input.type ??
                "number";

              return (
                <div class="input-group">

                  <label for={id}>

                    <span>
                      {label}
                    </span>

                    {
                      input.unit && (
                        <span class="unit">
                          {input.unit}
                        </span>
                      )
                    }

                  </label>


                  {
                    type === "select" ? (

                      <select
                        id={id}
                        name={id}
                        required={input.required ?? false}
                      >

                        {
                          Array.isArray(input.options) &&
                          input.options.map(
                            (option: any) => {

                              const value =
                                typeof option === "object"
                                  ? option.value
                                  : option;

                              const optionLabel =
                                typeof option === "object"
                                  ? option.label
                                  : option;

                              return (
                                <option value={value}>
                                  {optionLabel}
                                </option>
                              );
                            }
                          )
                        }

                      </select>

                    ) : type === "text" ? (

                      <input
                        id={id}
                        name={id}
                        type="text"
                        placeholder={
                          input.placeholder ?? ""
                        }
                        required={
                          input.required ?? false
                        }
                      />

                    ) : type === "date" ? (

                      <input
                        id={id}
                        name={id}
                        type="date"
                        required={
                          input.required ?? false
                        }
                      />

                    ) : (

                      <input
                        id={id}
                        name={id}
                        type="number"
                        step={
                          input.step ??
                          "any"
                        }
                        min={input.min}
                        max={input.max}
                        placeholder={
                          input.placeholder ?? ""
                        }
                        required={
                          input.required ?? false
                        }
                      />

                    )
                  }


                  {
                    (
                      input.help ??
                      input.description
                    ) && (
                      <small>
                        {
                          input.help ??
                          input.description
                        }
                      </small>
                    )
                  }

                </div>
              );
            })
          }

        </div>


        <!-- Buttons -->
        <div class="calculator-actions">

          <button
            type="submit"
            class="calculate-button"
          >
            <span class="button-icon">✓</span>
            Calculate
          </button>


          <button
            type="reset"
            class="reset-button"
          >
            Reset
          </button>

        </div>


        <!-- Result -->
        <section
          id="result"
          class="result-card"
          aria-live="polite"
          aria-atomic="true"
        >
        </section>

      </form>

    </section>


    <!-- Formula + References -->
    <section class="information-grid">

      <!-- Formula -->
      <article class="information-card">

        <div class="section-label">
          FORMULA
        </div>

        <h2>
          How is it calculated?
        </h2>

        <div class="formula-box">

          {
            calculator.formula ??
            "Calculation formula provided by the calculator."
          }

        </div>

      </article>


      <!-- References -->
      <article class="information-card">

        <div class="section-label">
          REFERENCES
        </div>

        <h2>
          Sources & References
        </h2>

        {
          references.length > 0 ? (

            <ol class="references">

              {
                references.map(
                  (reference: any) => (

                    <li>

                      {
                        reference?.url ? (

                          <a
                            href={reference.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {
                              reference.title ??
                              reference.name ??
                              reference.url
                            }
                          </a>

                        ) : (

                          reference?.title ??
                          reference?.name ??
                          String(reference)

                        )
                      }

                    </li>

                  )
                )
              }

            </ol>

          ) : (

            <p class="no-reference">
              References are currently being reviewed.
            </p>

          )
        }

      </article>

    </section>


    <!-- Medical Disclaimer -->
    <section class="disclaimer">

      <strong>
        Medical disclaimer
      </strong>

      <p>
        {
          calculator.disclaimer ??
          "This calculator is intended for educational and informational purposes only. It does not replace professional medical judgment, diagnosis, or treatment. Clinical decisions should be made by qualified healthcare professionals using the complete clinical context."
        }
      </p>

    </section>

  </main>


  <!-- =====================================================
       CLIENT-SIDE CALCULATOR ENGINE
       
       IMPORTANT:
       This is a normal Astro module script.
       DO NOT use define:vars here.
       ===================================================== -->

  <script>
    import {
      getCalculatorBySlug
    } from "../../engine/calculator-registry";


    const form =
      document.getElementById(
        "calculator-form"
      ) as HTMLFormElement | null;


    const result =
      document.getElementById(
        "result"
      ) as HTMLElement | null;


    /*
     * Escape values before inserting them into HTML.
     */
    function escapeHtml(
      value: unknown
    ): string {

      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }


    /*
     * Format a result value.
     */
    function formatValue(
      value: unknown
    ): string {

      if (
        typeof value === "number"
      ) {

        if (
          Number.isInteger(value)
        ) {
          return String(value);
        }

        return String(
          Number(
            value.toFixed(4)
          )
        );

      }

      return String(
        value ?? ""
      );

    }


    /*
     * Render calculator output.
     */
    function renderResult(
      calculation: any
    ) {

      if (!result) {
        return;
      }


      if (!calculation) {

        result.innerHTML = `
          <div class="error-message">
            <strong>
              No result was returned.
            </strong>
          </div>
        `;

        result.classList.add("visible");

        return;
      }


      let html = "";


      /*
       * PRIMARY RESULT
       */
      if (
        calculation.primary
      ) {

        const primary =
          calculation.primary;


        html += `
          <div class="result-main">

            <div class="result-label">
              ${escapeHtml(
                primary.label ??
                "Result"
              )}
            </div>

            <div class="result-number">

              ${escapeHtml(
                formatValue(
                  primary.value
                )
              )}

              ${
                primary.unit
                  ? `
                    <span class="result-unit">
                      ${escapeHtml(
                        primary.unit
                      )}
                    </span>
                  `
                  : ""
              }

            </div>

          </div>
        `;

      }


      /*
       * SECONDARY RESULTS
       */
      if (
        Array.isArray(
          calculation.secondary
        ) &&
        calculation.secondary.length
      ) {

        html += `
          <div class="secondary-results">
        `;


        calculation.secondary.forEach(
          (item: any) => {

            html += `
              <div class="secondary-row">

                <span>
                  ${escapeHtml(
                    item.label ??
                    ""
                  )}
                </span>

                <strong>

                  ${escapeHtml(
                    formatValue(
                      item.value
                    )
                  )}

                  ${
                    item.unit
                      ? `
                        <small>
                          ${escapeHtml(
                            item.unit
                          )}
                        </small>
                      `
                      : ""
                  }

                </strong>

              </div>
            `;

          }
        );


        html += `
          </div>
        `;

      }


      /*
       * INTERPRETATION
       */
      if (
        calculation.interpretation
      ) {

        html += `
          <div class="interpretation">

            <div class="interpretation-title">
              Interpretation
            </div>

            <p>
              ${escapeHtml(
                calculation.interpretation
              )}
            </p>

          </div>
        `;

      }


      /*
       * STATUS / CATEGORY
       */
      if (
        calculation.category
      ) {

        html += `
          <div class="result-category">

            <span>
              Category
            </span>

            <strong>
              ${escapeHtml(
                calculation.category
              )}
            </strong>

          </div>
        `;

      }


      result.innerHTML = html;

      result.classList.add(
        "visible"
      );


      result.scrollIntoView({
        behavior: "smooth",
        block: "nearest"
      });

    }


    /*
     * Render an error.
     */
    function renderError(
      message: unknown
    ) {

      if (!result) {
        return;
      }


      result.innerHTML = `
        <div class="error-message">

          <strong>
            Unable to calculate
          </strong>

          <p>
            ${escapeHtml(
              message ??
              "Please check the entered values and try again."
            )}
          </p>

        </div>
      `;


      result.classList.add(
        "visible"
      );

    }


    /*
     * MAIN CALCULATOR EVENT
     */
    if (
      form &&
      result
    ) {

      const slug =
        form.dataset.calculator;


      const calculator =
        slug
          ? getCalculatorBySlug(
              slug
            )
          : undefined;


      console.log(
        "[LABDECODED] Calculator:",
        slug
      );


      console.log(
        "[LABDECODED] Definition:",
        calculator
      );


      /*
       * Check that calculator loaded.
       */
      if (!calculator) {

        console.error(
          "[LABDECODED] Calculator not found:",
          slug
        );

        renderError(
          `Calculator "${slug}" could not be loaded.`
        );

      }


      /*
       * CALCULATE
       */
      form.addEventListener(
        "submit",
        (event) => {

          event.preventDefault();


          if (!calculator) {

            renderError(
              "Calculator could not be loaded."
            );

            return;

          }


          try {

            /*
             * Collect form values.
             */
            const formData =
              new FormData(form);


            /*
             * Convert FormData to a simple
             * string-based object.
             */
            const values: Record<
              string,
              string
            > = {};


            formData.forEach(
              (value, key) => {

                values[key] =
                  String(value);

              }
            );


            console.log(
              "[LABDECODED] Input values:",
              values
            );


            /*
             * Execute the actual calculator.
             */
            const calculation =
              calculator.calculate(
                values
              );


            console.log(
              "[LABDECODED] Calculation:",
              calculation
            );


            /*
             * Render result.
             */
            renderResult(
              calculation
            );

          } catch (
            error
          ) {

            console.error(
              "[LABDECODED] Calculation error:",
              error
            );


            const message =
              error instanceof Error
                ? error.message
                : "Please check the entered values and try again.";


            renderError(
              message
            );

          }

        }
      );


      /*
       * RESET
       */
      form.addEventListener(
        "reset",
        () => {

          setTimeout(
            () => {

              result.innerHTML =
                "";

              result.classList.remove(
                "visible"
              );

            },
            0
          );

        }
      );

    }

  </script>

</BaseLayout>


<style>

  .calculator-page {

    width:
      min(
        1100px,
        calc(100% - 32px)
      );

    margin:
      0 auto;

    padding:
      30px 0 70px;

  }


  /* Breadcrumb */

  .breadcrumb {

    display:
      flex;

    align-items:
      center;

    gap:
      8px;

    margin-bottom:
      28px;

    color:
      #64748b;

    font-size:
      14px;

  }


  .breadcrumb a {

    color:
      #2563eb;

    text-decoration:
      none;

    font-weight:
      600;

  }


  .breadcrumb a:hover {

    text-decoration:
      underline;

  }


  /* Header */

  .calculator-header {

    margin-bottom:
      28px;

  }


  .category-badge {

    display:
      inline-flex;

    align-items:
      center;

    padding:
      6px 12px;

    border-radius:
      999px;

    background:
      #eaf2ff;

    color:
      #2563eb;

    font-size:
      12px;

    font-weight:
      800;

    letter-spacing:
      .04em;

    text-transform:
      uppercase;

  }


  .calculator-header h1 {

    margin:
      14px 0 10px;

    color:
      #102a43;

    font-size:
      clamp(
        30px,
        5vw,
        46px
      );

    line-height:
      1.1;

  }


  .description {

    max-width:
      780px;

    margin:
      0;

    color:
      #64748b;

    font-size:
      17px;

    line-height:
      1.7;

  }


  /* Calculator card */

  .calculator-card {

    padding:
      30px;

    border:
      1px solid #e2e8f0;

    border-radius:
      18px;

    background:
      #ffffff;

    box-shadow:
      0 12px 40px
      rgba(
        15,
        35,
        60,
        .08
      );

  }


  /* Inputs */

  .input-grid {

    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(
          0,
          1fr
        )
      );

    gap:
      22px;

  }


  .input-group {

    display:
      flex;

    flex-direction:
      column;

  }


  .input-group label {

    display:
      flex;

    justify-content:
      space-between;

    align-items:
      center;

    gap:
      10px;

    margin-bottom:
      8px;

    color:
      #243b53;

    font-size:
      14px;

    font-weight:
      750;

  }


  .unit {

    color:
      #64748b;

    font-size:
      13px;

    font-weight:
      500;

  }


  .input-group input,
  .input-group select {

    width:
      100%;

    box-sizing:
      border-box;

    min-height:
      48px;

    padding:
      12px 14px;

    border:
      1px solid #d5dee9;

    border-radius:
      10px;

    background:
      #ffffff;

    color:
      #172b4d;

    font-size:
      15px;

    outline:
      none;

    transition:
      border-color .15s ease,
      box-shadow .15s ease;

  }


  .input-group input:focus,
  .input-group select:focus {

    border-color:
      #2563eb;

    box-shadow:
      0 0 0 3px
      rgba(
        37,
        99,
        235,
        .12
      );

  }


  .input-group small {

    margin-top:
      6px;

    color:
      #718096;

    font-size:
      12px;

    line-height:
      1.5;

  }


  /* Buttons */

  .calculator-actions {

    display:
      flex;

    gap:
      12px;

    margin-top:
      28px;

  }


  .calculate-button,
  .reset-button {

    min-height:
      48px;

    padding:
      12px 22px;

    border:
      0;

    border-radius:
      10px;

    font-size:
      15px;

    font-weight:
      750;

    cursor:
      pointer;

    transition:
      transform .12s ease,
      background .15s ease;

  }


  .calculate-button {

    flex:
      1;

    background:
      #2563eb;

    color:
      #ffffff;

  }


  .calculate-button:hover {

    background:
      #1d4ed8;

    transform:
      translateY(-1px);

  }


  .button-icon {

    margin-right:
      6px;

  }


  .reset-button {

    background:
      #eef2f7;

    color:
      #475569;

  }


  .reset-button:hover {

    background:
      #e2e8f0;

  }


  /* Result */

  .result-card {

    display:
      none;

    margin-top:
      25px;

    padding:
      26px;

    border:
      1px solid #cfe1f7;

    border-radius:
      14px;

    background:
      linear-gradient(
        135deg,
        #f0f7ff,
        #f8fbff
      );

  }


  .result-card.visible {

    display:
      block;

  }


  .result-main {

    text-align:
      center;

  }


  .result-label {

    color:
      #64748b;

    font-size:
      13px;

    font-weight:
      800;

    letter-spacing:
      .08em;

    text-transform:
      uppercase;

  }


  .result-number {

    margin-top:
      5px;

    color:
      #123b69;

    font-size:
      clamp(
        32px,
        6vw,
        48px
      );

    font-weight:
      850;

    line-height:
      1.15;

  }


  .result-unit {

    margin-left:
      8px;

    color:
      #64748b;

    font-size:
      16px;

    font-weight:
      600;

  }


  /* Secondary results */

  .secondary-results {

    margin-top:
      22px;

    border-top:
      1px solid #d9e6f3;

  }


  .secondary-row {

    display:
      flex;

    justify-content:
      space-between;

    align-items:
      center;

    gap:
      20px;

    padding:
      13px 0;

    border-bottom:
      1px solid #e2e8f0;

    color:
      #475569;

  }


  .secondary-row strong {

    color:
      #17345f;

  }


  .secondary-row small {

    margin-left:
      5px;

    color:
      #64748b;

    font-weight:
      500;

  }


  /* Interpretation */

  .interpretation {

    margin-top:
      22px;

    padding:
      18px;

    border-radius:
      10px;

    background:
      rgba(
        255,
        255,
        255,
        .7
      );

  }


  .interpretation-title {

    margin-bottom:
      6px;

    color:
      #17345f;

    font-weight:
      800;

  }


  .interpretation p {

    margin:
      0;

    color:
      #475569;

    line-height:
      1.65;

  }


  /* Errors */

  .error-message {

    color:
      #b42318;

    line-height:
      1.6;

  }


  .error-message strong {

    display:
      block;

    margin-bottom:
      5px;

  }


  .error-message p {

    margin:
      0;

  }


  /* Information */

  .information-grid {

    display:
      grid;

    grid-template-columns:
      repeat(
        2,
        minmax(
          0,
          1fr
        )
      );

    gap:
      20px;

    margin-top:
      20px;

  }


  .information-card {

    padding:
      24px;

    border:
      1px solid #e2e8f0;

    border-radius:
      16px;

    background:
      #ffffff;

  }


  .section-label {

    display:
      inline-block;

    color:
      #2563eb;

    font-size:
      11px;

    font-weight:
      850;

    letter-spacing:
      .1em;

  }


  .information-card h2 {

    margin:
      10px 0 16px;

    color:
      #243b53;

    font-size:
      20px;

  }


  .formula-box {

    padding:
      15px;

    border-radius:
      10px;

    background:
      #f5f8fc;

    color:
      #334155;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    line-height:
      1.65;

  }


  .references {

    margin:
      0;

    padding-left:
      22px;

    color:
      #64748b;

    line-height:
      1.7;

  }


  .references a {

    color:
      #2563eb;

    text-decoration:
      none;

  }


  .references a:hover {

    text-decoration:
      underline;

  }


  .no-reference {

    color:
      #64748b;

    font-size:
      14px;

  }


  /* Disclaimer */

  .disclaimer {

    margin-top:
      20px;

    padding:
      20px 24px;

    border:
      1px solid #e2e8f0;

    border-radius:
      14px;

    background:
      #f8fafc;

    color:
      #64748b;

    font-size:
      13px;

    line-height:
      1.7;

  }


  .disclaimer strong {

    color:
      #334155;

  }


  .disclaimer p {

    margin:
      6px 0 0;

  }


  /* Mobile */

  @media (
    max-width: 700px
  ) {

    .calculator-page {

      width:
        min(
          100% - 22px,
          1100px
        );

      padding-top:
        20px;

    }


    .calculator-card {

      padding:
        20px;

      border-radius:
        14px;

    }


    .input-grid,
    .information-grid {

      grid-template-columns:
        1fr;

    }


    .calculator-actions {

      flex-direction:
        column;

    }


    .calculate-button,
    .reset-button {

      width:
        100%;

    }

  }

</style>